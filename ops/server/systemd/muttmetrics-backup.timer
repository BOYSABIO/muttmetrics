# /etc/systemd/system/muttmetrics-backup.timer  (#93)
# 00:30: after midnight, before the 04:30 unattended-upgrades reboot window.
# Persistent=true: a run missed while the box was off happens at the next boot.
[Unit]
Description=Nightly MuttMetrics backup - #93

[Timer]
OnCalendar=*-*-* 00:30
Persistent=true

[Install]
WantedBy=timers.target
