# /etc/muttmetrics/healthchecks.env  (#104): root:root, mode 600.
# systemd reads it as root before starting the heartbeat and backup units, so
# nothing else on the box can read the URLs. Copy this file, then paste the two
# ping URLs from the Healthchecks.io check pages. They're secrets: anyone who has
# one can fake "all is well". Never commit the real file.
HC_HEARTBEAT_URL=https://hc-ping.com/<heartbeat-check-uuid>
HC_BACKUP_URL=https://hc-ping.com/<backup-check-uuid>
