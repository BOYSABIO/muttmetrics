# /etc/systemd/system/muttmetrics-api.service  (#93)
# The API, as the app account, on localhost only. Caddy is the only client.
[Unit]
Description=MuttMetrics API (uvicorn) - #93
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=muttmetrics
Group=muttmetrics
WorkingDirectory=/opt/muttmetrics
ExecStart=/opt/muttmetrics/.venv/bin/uvicorn muttmetrics.api.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# Photos the API writes are client data: owner-only (600), not the default 644.
UMask=0077

# Sandboxing: the API can write to its data folder and nothing else
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/muttmetrics
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
