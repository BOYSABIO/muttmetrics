# Copy to .env and fill in. Never commit real credentials or production URLs with embedded secrets.

# Postgres (docker-compose.yml reads POSTGRES_PASSWORD from this file).
# The password is set when the database volume is FIRST created; changing it
# here afterwards does nothing until you ALTER USER (docs/runbooks/db-peek.md).
# Use a URL-safe value so it can go straight into DATABASE_URL:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# An existing desktop volume was created with `muttmetrics`; keep that value
# there until the desktop is retired (#93).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://muttmetrics:change-me@127.0.0.1:5432/muttmetrics

# Hosted alternative (Neon): postgresql+psycopg://user:pass@ep-....neon.tech/neondb?sslmode=require

# API auth (#19 / #187 / #194) — required. Direct callers (curl, /docs) send
# header X-API-Key. The SPA never holds this key: Vite's /api proxy reads
# API_KEY from this file and injects the header server-side.
# The placeholder below is REFUSED at startup (too short / published example).
# Generate one (≥24 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=dev-change-me

# Photo storage (#30) — where capture photo files live.
# Deliberately OUTSIDE the repo: client photos are personal data and must never
# be committable. Defaults to ~/muttmetrics-data/photos if unset.
PHOTO_ROOT=C:/muttmetrics-data/photos

# Backups (#95). Outside the repo, same reasoning as PHOTO_ROOT.
# Today this is the same physical disk as the live data - it protects against
# mistakes (bad migration, wrong DELETE, down -v), not against drive failure.
BACKUP_ROOT=C:/muttmetrics-data/backups