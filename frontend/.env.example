# Copy to frontend/.env (never commit .env).
# Must match API_KEY in the repo root .env — same value as X-API-Key for JSON routes.
VITE_API_KEY=dev-change-me

# Salon name in the header and browser tab. Optional: empty shows just "MuttMetrics".
# Set the real name only in .env (gitignored) so it never lands in the public repo.
# Restart `npm run dev` after changing it.
VITE_BUSINESS_NAME=
