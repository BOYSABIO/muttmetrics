# Copy to frontend/.env (never commit .env).
#
# API auth (#194): the SPA does NOT hold the key. Vite's /api proxy reads
# API_KEY from the repo-root .env and adds X-API-Key server-side. Keep one
# value in root `.env` only — do not invent a VITE_API_KEY (that would ship
# in the bundle again). Root API_KEY refuses the placeholder `dev-change-me`
# and keys under 24 chars (#187).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Salon name in the header and browser tab. Optional: empty shows just "MuttMetrics".
# Set the real name only in .env (gitignored) so it never lands in the public repo.
# Restart `npm run dev` after changing it.
VITE_BUSINESS_NAME=
