# /etc/systemd/system/muttmetrics-backup.service  (#93, docs/runbooks/backup.md)
# One backup run (DB dump + additive photo copy), then a check of what it wrote.
# If either step fails, the unit shows as failed: that's what monitoring watches (#104).
[Unit]
Description=MuttMetrics backup (DB dump + photos) - #93
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=muttmetrics
Group=muttmetrics
WorkingDirectory=/opt/muttmetrics
ExecStart=/opt/muttmetrics/.venv/bin/python ops/backup.py
ExecStartPost=/opt/muttmetrics/.venv/bin/python ops/backup_check.py --max-age-hours 1
