# Copy to .env and fill in. Never commit real credentials or production URLs with embedded secrets.

# Local dev: matches docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql+psycopg://muttmetrics:muttmetrics@localhost:5432/muttmetrics

# Hosted alternative (Neon): postgresql+psycopg://user:pass@ep-....neon.tech/neondb?sslmode=require

# API auth (#19) — required. Callers send header: X-API-Key: <same value>
# Use a long random string in real deploys; this placeholder is fine for local only.
API_KEY=dev-change-me