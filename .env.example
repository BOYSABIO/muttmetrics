# Copy to .env and fill in. Never commit real credentials or production URLs with embedded secrets.

# Local dev: matches docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql+psycopg://muttmetrics:muttmetrics@localhost:5432/muttmetrics

# Hosted alternative (Neon): postgresql+psycopg://user:pass@host/db?sslmode=require
# Optional later (M3+):
# API_KEY=change-me
